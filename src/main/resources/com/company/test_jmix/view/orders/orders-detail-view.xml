<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://ordersDetailView.title">
    <data>
        <instance id="ordersDc"
                    class="com.company.test_jmix.entity.Orders">
            <fetchPlan extends="_base"/>
            <loader id="ordersDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout expand="form" spacing="true">
        <formLayout id="form" dataContainer="ordersDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="orderNumberField" property="orderNumber" width="100%"/>
            <numberField id="totalAmountField" property="totalAmount" width="100%"/>
            <datePicker id="orderDateField" property="orderDate"/>
            <numberField id="stockCountField" property="stockCount" width="100%"/>
        </formLayout>
        <hbox id="detailActions" classNames="buttons-panel">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
